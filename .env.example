# Copy this to .env and fill in your values
# Never commit .env to version control

PORT=8080

# Database
DB_URL=jdbc:mysql://<host>:3306/exam_hub?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Frontend URL(s) for CORS — comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Set to true when running behind HTTPS
SESSION_COOKIE_SECURE=true

# Directory to store proctoring video uploads
VIDEO_STORAGE_DIR=/var/data/proctoring-videos

# Log level for app code (INFO in prod, DEBUG in dev)
LOG_LEVEL=INFO
